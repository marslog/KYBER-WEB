# Public site URL (SEO canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.kyber-it.com

# --- Google Search & Analytics (recommended for production) ---
# 1. Google Search Console: https://search.google.com/search-console
#    Add property www.kyber-it.com → HTML tag verification → paste token below
GOOGLE_SITE_VERIFICATION=
# 2. Google Analytics 4: https://analytics.google.com → Admin → Data streams → Measurement ID (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Option A (recommended on Vercel): Resend ---
# 1. Create account at https://resend.com
# 2. Add & verify domain kyber-it.com (DNS TXT records in Squarespace)
# 3. Create API key and paste below
RESEND_API_KEY=
EMAIL_FROM=KYBER <info@kyber-it.com>

# --- Option B: Gmail SMTP (App Password) ---
# 1. Enable 2-Step Verification on the Google account
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Add "Send mail as" for info@kyber-it.com in Gmail if using that From address
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=

# Recipient for contact form submissions
CONTACT_TO=supawat@kyber-it.com
PROJECT_REGISTRATION_TO=supawat@kyber-it.com

# --- Portal admin login (navbar modal + Knowledge Base menu unlock) ---
PORTAL_ADMIN_USERNAME=kyber
PORTAL_ADMIN_PASSWORD=Kyber@admin123
# Use a long random string in production (e.g. openssl rand -base64 32)
PORTAL_SESSION_SECRET=
# Optional path override for RBAC user store (default: data/portal-users.json)
PORTAL_USERS_FILE=
